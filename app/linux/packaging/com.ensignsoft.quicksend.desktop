[Desktop Entry]
Name=Quick Send
GenericName=Local network file transfer
Comment=Send files to devices on your local network
Exec=quicksend %U
Icon=com.ensignsoft.quicksend
Terminal=false
Type=Application
Categories=Network;FileTransfer;
StartupNotify=true
StartupWMClass=com.ensignsoft.quicksend
Keywords=files;transfer;sharing;LAN;
Name[tr]=Quick Send
Comment[tr]=Yerel ağındaki cihazlara dosya gönder
Actions=open-window;

[Desktop Action open-window]
Name=Open window
Name[tr]=Pencereyi aç
Exec=quicksend --show
